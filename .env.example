# OpenRouter API keys (comma-separated)
OPENROUTER_API_KEYS=sk-xxxxxx,sk-yyyyyy
# Optional single key fallback if only one key is used
OPENROUTER_API_KEY=sk-xxxxxx

# Authentication credentials for app login
USER01_USER=yourusername
USER01_PASS=yourpassword

# Optional Vite-specific auth env vars (same values as above)
VITE_USER01_USER=yourusername
VITE_USER01_PASS=yourpassword

# Default model selection for the app
VITE_DEFAULT_MODEL=ling-3.0-flash

# Optional Gemini API keys if you use the Gemini client elsewhere
# VITE_GEMINI_API_KEY=your_gemini_api_key
# VITE_GEMINI_API_KEYS=key1,key2
